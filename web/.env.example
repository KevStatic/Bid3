# Copy to .env.local for local development, and set the same keys in Vercel.
# All of these are public (NEXT_PUBLIC_*) and ship to the browser. Never put a private key here.

# Bid3 engine. Leave both empty to run the labelled in-browser simulation.
# Site on the engine's laptop: NEXT_PUBLIC_ENGINE_WS_URL=/engine plus ENGINE_URL below, so the browser
# (and a phone, through the site's own address) reaches the engine through this site.
# Site elsewhere (Vercel): the engine's public URL, e.g. wss://<tunnel>; HTTP is derived from it.
NEXT_PUBLIC_ENGINE_HTTP_URL=
NEXT_PUBLIC_ENGINE_WS_URL=

# Arkiv: "sample" uses bundled sample entities; "live" reads the Rabdi testnet from the browser.
NEXT_PUBLIC_ARKIV_MODE=sample
# Read-only access key from https://hub.arkiv.network/access-keys (it is visible to users).
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Or keep every key out of the browser: leave the key above empty, send reads through this site
# (app/api/arkiv-rpc, reads only), and give the server the RPC URL with the key in it.
NEXT_PUBLIC_ARKIV_RPC_PATH=
# Server-only, e.g. https://rpc.rabdi.db-chain.testnet.arkiv.network/<access key>
ARKIV_RPC_URL=
NEXT_PUBLIC_ARKIV_CHAIN_ID=7794095
NEXT_PUBLIC_ARKIV_EXPLORER_URL=https://rabdi.explorer.arkiv.network

# The Bid3 publisher wallet. Results owned by any other wallet are flagged "Unverified issuer".
NEXT_PUBLIC_PUBLISHER_ADDRESS=

# Auction shown on the home page and in the "Live room" nav link.
NEXT_PUBLIC_FEATURED_AUCTION_ID=bid3-003

# Server-only (never NEXT_PUBLIC): the admin page and the payment routes call the engine with this token.
ADMIN_TOKEN=
ADMIN_PASSWORD=
# Server-only: where this server reaches the engine, when they share a laptop (http://localhost:8010).
# Turns on the /engine pass-through (next.config.ts). Read at build time: rebuild after changing it.
ENGINE_URL=
# Optional: the Sepolia RPC the payment check uses (default: https://ethereum-sepolia-rpc.publicnode.com).
SEPOLIA_RPC_URL=
