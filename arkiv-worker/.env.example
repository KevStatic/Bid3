# Bid3 Arkiv worker. Copy to .env (or set on Railway).

ENGINE_URL=http://localhost:8010
WORKER_TOKEN=

# The Bid3 publisher wallet. Without it the worker runs dry and writes nothing.
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

POLL_MS=1500
# Testing only: in dry runs, report fake keys so the engine's outbox empties.
DRY_RUN_ACK=0

# Sepolia gas station (src/gas-station.ts): tops up every wallet linked to a paddle so phone wallets can pay.
# A testnet-only key; fund its address (printed on start) with some Sepolia ETH. Off when empty.
GAS_STATION_KEY=
# GAS_MIN_ETH=0.002
# GAS_TOPUP_ETH=0.005
# GAS_MAX_TOPUPS_PER_HOUR=12
