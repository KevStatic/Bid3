# Environment variables for the Bid3 backend on Render (Service > Environment).
# Render reads them from its dashboard, not from this file. For a local test run:
#   docker build -f backend/Dockerfile -t bid3-backend .
#   docker run --rm -p 8097:10000 --env-file backend/.env bid3-backend
# (copy this file to backend/.env first; that file is gitignored.)

# --- Required ---------------------------------------------------------------------------------
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Use NEW values, not the ones in engine/.env. The engine refuses to start if any is empty.
BRIDGE_TOKEN=
ADMIN_TOKEN=
WORKER_TOKEN=

# Browsers allowed to call this backend.
CORS_ORIGINS=https://bid3.vercel.app,http://localhost:3000

# --- Recommended --------------------------------------------------------------------------------
# Already 1 in the image; keep it explicit.
REQUIRE_TOKENS=1
# Creates and opens demo lot bid3-003 (paddles TAG1->K7, TAG2->M4) on every fresh start, so /auctions
# isn't empty. Set to 0 if you turn on the Arkiv worker below (otherwise each restart publishes it again).
SEED_DEMO=1
# Same 10 s hammer countdown as the hardware rounds.
SEED_COUNTDOWN_MS=10000

# --- Optional: Arkiv worker in the same container -------------------------------------------------
# Leave empty and only the engine runs. If set, it MUST be a separate wallet funded with a little tGLM,
# never the laptop's publisher key (the container refuses that one).
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# --- Don't set ----------------------------------------------------------------------------------
# PORT: Render sets it. DATABASE_PATH: the image sets /app/data/bid3.sqlite (wiped on restart on the
# free plan; use /data/bid3.sqlite with a paid disk at /data). PAYMENTS: leave off; the site's payment
# flow talks to the laptop engine.
