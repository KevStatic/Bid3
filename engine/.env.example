# Bid3 engine settings. Copy to .env for local runs; set the same keys on Railway/Fly.

PORT=8010
DATABASE_PATH=./data/bid3.sqlite

# Shared secrets. Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty tokens are accepted only for local development.
BRIDGE_TOKEN=
ADMIN_TOKEN=
WORKER_TOKEN=

# The web app's origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# Resume on its own once the bridge and every paddle are back. 0 = an operator calls /resync.
AUTO_RESUME=1
# 1 = reject intents without a valid secp256k1 signature from the tag's enrolled key.
INTENT_SIGNATURES_REQUIRED=0
SNAPSHOT_INTERVAL_MS=4000

# Demo auction bid3-003, created and opened on first start. Tag refs must match what the gateway sends.
SEED_DEMO=1
SEED_TAGS=TAG1:K7,TAG2:M4
SEED_COUNTDOWN_MS=5000

LOG_LEVEL=INFO

# Refuse to start if any token above is empty. On by default on Railway; set to 1 on any other public host.
# REQUIRE_TOKENS=1
